# Supabase — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ImageKit — Developer options > API keys
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/YOUR_IMAGEKIT_ID

# CMS panel login
PANEL_PASSWORD=replace-with-a-strong-password
PANEL_SESSION_SECRET=replace-with-a-long-random-secret
SUBMISSION_FINGERPRINT_SECRET=replace-with-another-long-random-secret
